# ==============================================================================
# .env.example — LLM Sentiment Analysis & Sales Forecasting FYP
# Copy this file to backend/.env (or root .env) and fill in your credentials.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Replace with your actual MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=fyp_db

# ── Ollama Local LLM Service ──────────────────────────────────────────────────
# URL of your local Ollama instance (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ── Backend Configuration ─────────────────────────────────────────────────────
DEBUG=false
